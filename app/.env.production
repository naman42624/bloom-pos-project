# Not a secret. Committed on purpose (plain .env is git-ignored).
# Expo SDK 56+ replaces the global fetch with expo/fetch on iOS/Android. expo/fetch cannot
# send React Native FormData file parts ({ uri, name, type }), which every photo/voice
# upload in src/services/api.js uses, so keep React Native's own fetch (as on SDK 54).
EXPO_PUBLIC_USE_RN_FETCH=1
